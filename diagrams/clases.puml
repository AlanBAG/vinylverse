@startuml
skinparam classAttributeIconSize 0

class Usuario {
  - id_usuario : int
  - nombre : string
  - apellido : string
  - correo : string
  - contraseña : string
  - telefono : string
  - direccion : string
  - fechaRegistro : date
  - rol : string
  - estado : boolean

  + login()
  + registrarse()
  + editarPerfil()
  + cerrarSesion()
}

class Venta {
  - id_venta : int
  - fechaVenta : date
  - total : decimal
  - metodoPago : string
  - estado : string
  - direccionEnvio : string
  - folio : string

  + generarPDF()
  + confirmarVenta()
  + cancelarVenta()
}

class DetalleVenta {
  - id_detalle : int
  - cantidad : int
  - precioUnit : decimal
  - subtotal : decimal

  + calcularSubtotal()
}

class Vinilo {
  - id_vinilo : int
  - titulo : string
  - genero : string
  - año : int
  - canciones : int
  - precio : decimal
  - stock : int
  - formato : string
  - discografica : string
  - descripcion : text
  - imagen : string
  - estado : boolean

  + actualizarStock()
  + mostrarInfo()
  + cambiarPrecio()
}

class Artista {
  - id_artista : int
  - nombre : string
  - pais : string
  - genero : string
  - biografia : text
  - activo : boolean

  + crear()
  + editar()
}

class Proveedor {
  - id_proveedor : int
  - empresa : string
  - direccion : string
  - telefono : string
  - correo : string
  - pais : string
  - contacto : string
  - estado : boolean

  + registrar()
  + editar()
}

class Comentario {
  - id_comentario : int
  - comentario : text
  - calificacion : int
  - fecha : date
  - estado : boolean

  + publicar()
  + editar()
  + eliminar()
}

    Usuario "1" *-- "1..*" Venta : realiza
    Venta "1" *-- "1..*" DetalleVenta : contiene
    DetalleVenta "*" --> Vinilo : pertenece
    Vinilo "1" --> Artista : creado_por
    Vinilo "1" --> Proveedor : suministrado_por
    Usuario "1" *-- "0..*" Comentario : escribe
    Vinilo "1" o-- "0..*" Comentario : recibe

@enduml
